# Godot 4 specific overrides
.godot/
*.translation
*.log

# Ignore python compiled cache globally
__pycache__/
*.pyc
*.pyo
*.pyd

# Ignore the heavy python addon binaries (matching your actual folder name: py4godot)
addons/py4godot/

# ...BUT explicitly make sure Git tracks your custom source Python files
!PythonFiles/**/*.py

.env